# JobPilot 环境变量示例 —— 复制成 `.env` 并填入真实值
#
# ┌ 怎么用 ─────────────────────────────────────────────────────────────┐
# │ 1. 复制：           cp .env.example .env                            │
# │ 2. 填入下面的值（.env 已被 .gitignore 忽略，不会入库）                │
# │ 3. 启动：           Spring 会自动读取根目录的 .env（见 application.yml │
# │                     的 spring.config.import），无需 export           │
# └─────────────────────────────────────────────────────────────────────┘
#
# 格式：KEY=value（**不加引号、不写 `export`**；Spring 按 properties 文件解析）。
#
# 两条路径怎么选——只改第一行 `JOBPILOT_AGENT_PROVIDER_PATH`：
#   - openai ：云端（嵌入走 SiliconFlow、对话走智谱）。需要下面两个 key。
#   - ollama ：本地（默认）。只需本机装了 Ollama 且拉了模型，**不需要任何 key**。
# 一处切换，`spring.ai.model.chat` / `spring.ai.model.embedding` 会跟着一起变。

# 提供商：openai | ollama
JOBPILOT_AGENT_PROVIDER_PATH=openai

# ── 对话（OpenAI 兼容）─────────────────────────────────────
# 智谱 GLM：到 https://open.bigmodel.cn 申请，key 形如 `<id>.<secret>`
JOBPILOT_OPENAI_CHAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
JOBPILOT_OPENAI_CHAT_API_KEY=your-zhipu-api-key
JOBPILOT_RAG_CHAT_MODEL=glm-4.7-flash

# ── 嵌入（OpenAI 兼容）─────────────────────────────────────
# SiliconFlow：到 https://siliconflow.cn 申请，key 形如 `sk-...`
# bge-large-zh-v1.5 是 1024 维；换模型后必须重建索引（POST /api/v1/knowledge/documents/reindex-all）
JOBPILOT_OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
JOBPILOT_OPENAI_EMBEDDING_API_KEY=sk-your-siliconflow-api-key
JOBPILOT_RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ── 重排序（SiliconFlow 的 /rerank）─────────────────────────
# 关掉（false）也能跑：检索直接用向量分数排序
JOBPILOT_RERANK_ENABLED=true
JOBPILOT_RERANK_BASE_URL=https://api.siliconflow.cn/v1
JOBPILOT_RERANK_API_KEY=sk-your-siliconflow-api-key
JOBPILOT_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── 管理端（第二认证轴）─────────────────────────────────────
# 三个值都填上才启用管理面；JOBPILOT_ADMIN_USERNAME 留空 = 禁用（应用照常启动）。
# jwt-secret 必须与 JOBPILOT_SECURITY_JWT_SECRET 不同（两把钥匙、两条认证轴）。
JOBPILOT_ADMIN_USERNAME=
JOBPILOT_ADMIN_PASSWORD=
JOBPILOT_ADMIN_JWT_SECRET=
